# =====================================================================
# JARVIS V1 — Environment Configuration
# =====================================================================

# LLM Provider (OpenAI Responses / Structured Output)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna

# Web Search Provider (Tavily Search API)
TAVILY_API_KEY=your_tavily_api_key_here

# Google Sheets Configuration
# The ID is found in your Google Sheet URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

INPUT_TAB=Input
OUTPUT_TAB=Output

# Performance & Concurrency
MAX_WORKERS=5
MAX_SEARCH_RESULTS=6
CACHE_TTL_HOURS=168
REQUEST_TIMEOUT=20

# Confidence Thresholds
MIN_CONFIDENCE=75

# Speech & Voice Settings
TTS_VOICE_RATE=180
TTS_VOLUME=1.0
VOICE_INPUT_TIMEOUT=8
